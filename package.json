{
  "name": "mediago_monetization_sdk_mcp",
  "version": "1.1.0",
  "description": "Official Model Context Protocol (MCP) Server & CLI Wizard for MediaGo Monetization SDK (Android & Unity) integration, mediation configuration, static code/Gradle audit, cache queue generation, error diagnosis, and Logcat trace analysis.",
  "main": "src/server.js",
  "bin": {
    "mediago_monetization_sdk_mcp": "./bin/mediago_monetization_sdk_mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "data/",
    "README.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "sync-compat": "node -e \"const fs=require('fs'),p=require('path'),src=p.resolve(__dirname,'../mediago_monetization_sdk_skills/compatibility/compatibility.json'),dst=p.resolve(__dirname,'data/compatibility.json');if(fs.existsSync(src)){fs.mkdirSync(p.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);console.log('Synced compatibility.json from ../mediago_monetization_sdk_skills');}\"",
    "prepack": "npm run sync-compat",
    "start": "node ./bin/mediago_monetization_sdk_mcp.js",
    "test": "node ./test/test-mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mediagoinapp-star/mediago_monetization_sdk_mcp.git"
  },
  "homepage": "https://github.com/mediagoinapp-star/mediago_monetization_sdk_mcp#readme",
  "bugs": {
    "url": "https://github.com/mediagoinapp-star/mediago_monetization_sdk_mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mediago",
    "monetization",
    "admaster",
    "android-sdk",
    "ads"
  ],
  "license": "Apache-2.0"
}
